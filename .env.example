# Пример переменных окружения (по умолчанию проект работает и без них).
# true — работаем на тестовых данных из mocks/, без подключения к API заказчика
USN_USE_MOCKS=true
# Адрес API тестовой площадки заказчика (выдаст заказчик; пути сверяем со Swagger)
USN_API_BASE_URL=https://example.invalid/api
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
